# providers
GROQ_API_KEY=
GROQ_API_KEY_2=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=

# model overrides (optional; defaults in config/providers.yaml)
GROQ_MODEL=
GROQ_ALT_MODEL=
GEMINI_MODEL=
CEREBRAS_MODEL=
MISTRAL_MODELS=
OPENROUTER_MODELS=
OPENROUTER_APP_NAME=Automatron
OPENROUTER_SITE_URL=

# vector db
QDRANT_URL=
QDRANT_API_KEY=
EMBED_MODEL=BAAI/bge-small-en-v1.5

# app
PORT=7860
LOG_LEVEL=INFO
APP_USERNAME=
# The operator credential. Without Supabase it also guards the interface and API;
# with Supabase it guards only /ops and /metrics, which see every tenant's metadata.
APP_PASSWORD=
# Multi-user mode: set both and every API caller and interface login is a Supabase
# user who sees only their own runs. Use the publishable (or legacy anon) key; a
# secret or service-role key is refused at startup.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Run content is encrypted before it is stored. Set one: a Cloud KMS key
# (projects/<p>/locations/<l>/keyRings/<r>/cryptoKeys/<k>), or a keyring of base64
# 32-byte keys from a secret manager, newest first:  k2:<base64>,k1:<base64>
# Generate a key with: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
RUN_KMS_KEY=
RUN_ENCRYPTION_KEYS=
AUTOMATRON_FAKE_LLM=0
DATA_DIR=./data
RUNTIME_DIR=/tmp/automatron
MAX_UPLOAD_MB=10
# a run's ceiling in seconds; free provider tiers queue, so allow for it
RUN_TIMEOUT_S=600
MAX_PARALLEL_STEPS=2
RATE_LIMIT_PER_IP_PER_HOUR=30

# sector thresholds (override config/sectors.yaml)
TRADE_APPROVAL_THRESHOLD_USD=100000
ECOM_HIGH_VALUE_THRESHOLD_USD=500
